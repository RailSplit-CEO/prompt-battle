{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@prompt-battle/shared": ["../shared/src"],
      "@prompt-battle/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
