{
  "rules": {
    "users": {
      ".indexOn": ["username"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16"
        },
        "icon": {
          ".validate": "newData.isString()"
        },
        "provider": {
          ".validate": "newData.val() === 'google' || newData.val() === 'anonymous' || newData.val() === 'itch'"
        },
        "wallet": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        },
        "inventory": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        },
        "equipped": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "battlePass": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        },
        "dailyRewards": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        },
        "playerLevel": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        },
        "activeBoosters": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChild('uid') && newData.child('uid').val() === auth.uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)"
        }
      }
    },
    "invites": {
      "$targetUid": {
        ".read": "auth != null && auth.uid === $targetUid",
        "$inviteId": {
          ".write": "auth != null"
        }
      }
    },
    "matchHistory": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "ratings": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "leaderboard": {
      ".indexOn": ["rating"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "activeBoosters": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "matchmaking": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "games": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "transactions": {
      ".read": false,
      ".write": false
    },
    "redeemedKeys": {
      ".read": false,
      ".write": false
    },
    "catalog": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
